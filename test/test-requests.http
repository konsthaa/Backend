# api http test requests for VSCode
@apiUrl = http://127.0.0.1:3000/api/v1


##Get created user
GET {{apiUrl}}/users/38

### test user database works
GET {{apiUrl}}/users

### get cats
GET {{apiUrl}}/cats

### get cat by id
GET {{apiUrl}}/cats/8

### confirm name stays unchanged
GET {{apiUrl}}/cats/41

### get cat by id (FAIL: not found)
GET {{apiUrl}}/cats/98

### Verify change
GET {{apiUrl}}/users/38


### create auth test user
POST {{apiUrl}}/users
Content-Type: application/json

{
  "name": "Auth Test",
  "username": "auth_test_01",
  "email": "auth_test_01@example.com",
  "password": "dummy-test-password"
}


### login
# @name login
POST {{apiUrl}}/auth/login
Content-Type: application/json

{
  "username": "auth_test_01",
  "password": "dummy-test-password"
}

### Create cat as logged-in user
# @name createOwnedCat
POST {{apiUrl}}/cats
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "cat_name": "Auth ownership test",
  "birthdate": "2022-10-10",
  "weight": 4,
  "owner": 37,
  "filename": "auth-test.jpg"
}

### Check the owner
GET {{apiUrl}}/cats/51

### get authenticated user
GET {{apiUrl}}/auth/me
Authorization: Bearer {{login.response.body.token}}

### Create a new user and check that the password is hashed in the database
POST {{apiUrl}}/users

### create a temporary test user
POST {{apiUrl}}/users
Content-Type: application/json

{
  "name": "Assignment Test",
  "username": "assignment_test_01",
  "email": "assignment_test_01@example.com",
  "password": "temporary-test-password",
  "role": "user"
}

### test whether i can edit someone else's cat
PUT {{apiUrl}}/cats/41
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "cat_name": "Should not change"
}

### test updating another users record
PUT {{apiUrl}}/users/37
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "name": "Should not change"
}

### Trying to promote myself (expecting 403)
PUT {{apiUrl}}/users/40
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "role": "admin"
}


### Update my own cat (expecting success)
PUT {{apiUrl}}/cats/51
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "cat_name": "Auth ownership test updated"
}

### update the temporary test user
PUT {{apiUrl}}/users/38
Content-Type: application/json

{
  "name": "Assignment Test Updated"
}

### delete temporary test user
DELETE {{apiUrl}}/users/38

# cat_name, weight, owner, filename, birthdate
### post new cat
POST {{apiUrl}}/cats
Content-Type: application/json

{
    "cat_name": "Rolle",
    "birthdate": "2022-10-10",
    "weight": 4,
    "owner": 37,
    "filename": "https://placecats.com/310/240"
}

### post cat WITH IMAGE
POST http://127.0.0.1:3000/api/v1/cats HTTP/1.1
Content-Type: multipart/form-data; boundary=MyBoundary

--MyBoundary
Content-Disposition: form-data; name="cat_name"

Misu
--MyBoundary
Content-Disposition: form-data; name="weight"

6
--MyBoundary
Content-Disposition: form-data; name="owner"

37
--MyBoundary
Content-Disposition: form-data; name="birthdate"

2023-10-08
--MyBoundary
Content-Disposition: form-data; name="image"; filename="cat.jpg"
Content-Type: image/jpeg

< ./cat.jpg
--MyBoundary--

### edit existing cat
PUT {{apiUrl}}/cats/8
Content-Type: application/json

{
    "weight": 6,
    "owner": "Uusi omistaja"
}

### delete cat by id
DELETE {{apiUrl}}/cats/8

### delete user 39
DELETE {{apiUrl}}/users/39

### protected route without token (expect 401)
DELETE {{apiUrl}}/cats/999999


### protected route with token (expect 404 for nonexistent cat)
DELETE {{apiUrl}}/cats/999999
Authorization: Bearer {{login.response.body.token}}

### test deleting cat 41
DELETE {{apiUrl}}/cats/41
Authorization: Bearer {{login.response.body.token}}



### creating a disposable account
POST {{apiUrl}}/users
Content-Type: application/json

{
  "name": "Temporary Admin Test",
  "username": "temp_admin_test",
  "email": "temp_admin_test@example.com",
  "password": "temporary-admin-password"
}


### Login as temporary admin
# @name adminLogin
POST {{apiUrl}}/auth/login
Content-Type: application/json

{
  "username": "temp_admin_test",
  "password": "temporary-admin-password"
}


### Admin updates another user's cat
PUT {{apiUrl}}/cats/51
Authorization: Bearer {{adminLogin.response.body.token}}
Content-Type: application/json

{
  "cat_name": "Admin authorization test"
}


### Admin updates another user's user record
PUT {{apiUrl}}/users/40
Authorization: Bearer {{adminLogin.response.body.token}}
Content-Type: application/json

{
  "name": "Admin Authorization Test"
}
