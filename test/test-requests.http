### Assignment 7 user error-handler tests
# Create this test user once, then use the login request below.
# @name assignment7TestUser
POST {{apiUrl}}/users
Content-Type: application/json

{
  "name": "Assignment 7 Test",
  "username": "a7verify0911",
  "email": "a7verify0911@example.com",
  "password": "assignment7-test-password"
}

### Login as the Assignment 7 test user
# @name assignment7Login
POST {{apiUrl}}/auth/login
Content-Type: application/json

{
  "username": "a7verify0911",
  "password": "assignment7-test-password"
}

### Invalid user ID on update (expect shared JSON 400)
PUT {{apiUrl}}/users/not-a-number
Authorization: Bearer {{assignment7Login.response.body.token}}
Content-Type: application/json

{
  "name": "Invalid ID test"
}

### Invalid user ID on delete (expect shared JSON 400)
DELETE {{apiUrl}}/users/not-a-number
Authorization: Bearer {{assignment7Login.response.body.token}}

### Non-admin cannot update another user (expect 403)
PUT {{apiUrl}}/users/99999999
Authorization: Bearer {{assignment7Login.response.body.token}}
Content-Type: application/json

{
  "name": "Forbidden update test"
}

### Non-admin cannot delete another user (expect 403)
DELETE {{apiUrl}}/users/99999999
Authorization: Bearer {{assignment7Login.response.body.token}}

### Missing user on update (expect shared JSON 404; run a successful adminLogin first)
PUT {{apiUrl}}/users/99999999
Authorization: Bearer {{adminLogin.response.body.token}}
Content-Type: application/json

{
  "name": "Missing user update test"
}

### Missing user on delete (expect shared JSON 404; run a successful adminLogin first)
DELETE {{apiUrl}}/users/99999999
Authorization: Bearer {{adminLogin.response.body.token}}

### Clean up the temporary Assignment 7 test user (run after the other checks)
DELETE {{apiUrl}}/users/{{assignment7TestUser.response.body.user_id}}
Authorization: Bearer {{assignment7Login.response.body.token}}

### Invalid Id no delete - 400
DELETE {{apiUrl}}/users/not-a-number
Authorization: Bearer {{login.response.body.token}}

