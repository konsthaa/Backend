# api http test requests for VSCode
@apiUrl = http://127.0.0.1:3000/api/v1


##Get created user
GET {{apiUrl}}/users/38

### test user database works
GET {{apiUrl}}/users

### get cats
GET {{apiUrl}}/cats

### get cat by id
GET {{apiUrl}}/cats/8

### get cat by id (FAIL: not found)
GET {{apiUrl}}/cats/98

### Verify change
GET {{apiUrl}}/users/38


### create auth test user
POST {{apiUrl}}/users
Content-Type: application/json

{
  "name": "Auth Test",
  "username": "auth_test_01",
  "email": "auth_test_01@example.com",
  "password": "dummy-test-password"
}


### login
# @name login
POST {{apiUrl}}/auth/login
Content-Type: application/json

{
  "username": "auth_test_01",
  "password": "dummy-test-password"
}

### get authenticated user
GET {{apiUrl}}/auth/me
Authorization: Bearer {{login.response.body.token}}

### Create a new user and check that the password is hashed in the database
POST {{apiUrl}}/users

### create a temporary test user
POST {{apiUrl}}/users
Content-Type: application/json

{
  "name": "Assignment Test",
  "username": "assignment_test_01",
  "email": "assignment_test_01@example.com",
  "password": "temporary-test-password",
  "role": "user"
}

### update the temporary test user
PUT {{apiUrl}}/users/38
Content-Type: application/json

{
  "name": "Assignment Test Updated"
}

### delete temporary test user
DELETE {{apiUrl}}/users/38

# cat_name, weight, owner, filename, birthdate
### post new cat
POST {{apiUrl}}/cats
Content-Type: application/json

{
    "cat_name": "Rolle",
    "birthdate": "2022-10-10",
    "weight": 4,
    "owner": 37,
    "filename": "https://placecats.com/310/240"
}

### post cat WITH IMAGE
POST http://127.0.0.1:3000/api/v1/cats HTTP/1.1
Content-Type: multipart/form-data; boundary=MyBoundary

--MyBoundary
Content-Disposition: form-data; name="cat_name"

Misu
--MyBoundary
Content-Disposition: form-data; name="weight"

6
--MyBoundary
Content-Disposition: form-data; name="owner"

37
--MyBoundary
Content-Disposition: form-data; name="birthdate"

2023-10-08
--MyBoundary
Content-Disposition: form-data; name="image"; filename="cat.jpg"
Content-Type: image/jpeg

< ./cat.jpg
--MyBoundary--

### edit existing cat
PUT {{apiUrl}}/cats/8
Content-Type: application/json

{
    "weight": 6,
    "owner": "Uusi omistaja"
}

### delete cat by id
DELETE {{apiUrl}}/cats/8

### delete user 39
DELETE {{apiUrl}}/users/39

### protected route without token (expect 401)
DELETE {{apiUrl}}/cats/999999


### protected route with token (expect 404 for nonexistent cat)
DELETE {{apiUrl}}/cats/999999
Authorization: Bearer {{login.response.body.token}}
