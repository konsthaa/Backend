# api http test requests for VSCode
@apiUrl = http://127.0.0.1:3000/api/v1


### get cats
GET {{apiUrl}}/cats

### get cat by id
GET {{apiUrl}}/cats/8

### get cat by id (FAIL: not found)
GET {{apiUrl}}/cats/98

### post new cat
POST {{apiUrl}}/cats
Content-Type: application/json

{
    "name": "Rolle",
    "birthdate": "2022-10-10",
    "weight": 4,
    "owner": "Tiina",
    "image": "https://placecats.com/310/240"
}

### edit existing cat
PUT {{apiUrl}}/cats/8
Content-Type: application/json

{
    "weight": 6,
    "owner": "Uusi omistaja"
}

### delete cat by id
DELETE {{apiUrl}}/cats/8

### get all users
GET {{apiUrl}}/users

### get user by id
GET {{apiUrl}}/users/3609

### get user by id (not found)
GET {{apiUrl}}/users/9999

### add new user
POST {{apiUrl}}/users
Content-Type: application/json

{
    "name": "Alex Example",
    "username": "alexexample",
    "email": "alex@metropolia.fi",
    "role": "user",
    "password": "password"
}

### update user (fixed response)
PUT {{apiUrl}}/users/3609
Content-Type: application/json

{
    "name": "Updated Name"
}

### delete user (fixed response)
DELETE {{apiUrl}}/users/3609
